{
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "OutboxPublisher": {
    "LoanEventsStream": "loan-events",
    "PollInterval": "00:00:02",
    "MaxBackoff": "00:01:00",
    "MaxAttempts": 5,
    "LoanEventsStreamMaxLength": 100000
  },
  "LoanDecisionConsumer": {
    "LoanDecisionsStream": "loan-decisions",
    "ConsumerGroup": "loan-service"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
